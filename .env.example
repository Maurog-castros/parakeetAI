# Copy to .env and fill in. .env is git-ignored.
IAMIKO_BASE_URL=https://ia.iamiko.cl/v1
IAMIKO_API_KEY=
# Chat model name as exposed by the gateway (see `npm run start` console: it prints /models)
CHAT_MODEL=
# Whisper-style transcription model name (leave blank to disable STT and use mic Web Speech fallback)
STT_MODEL=
# Language hint for transcription (ISO-639-1), optional
STT_LANG=es
