# Copy to .env and fill in. .env is git-ignored.
# Chat LLM: iamiko gateway (custom header auth)
IAMIKO_BASE_URL=https://ia.iamiko.cl/vscode/v1
IAMIKO_TOKEN=
CHAT_MODEL=auto-vscode

# Realtime STT: iamiko voice gateway (Deepgram-compatible WebSocket)
STT_URL=wss://stt.iamiko.cl/v1/listen
STT_TOKEN=
STT_LANG=es

# Deepgram key: only for interviewer TTS in practice mode (gateway has no /v1/speak)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-olivia-es
